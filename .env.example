# ============================================
# LOCAL DEVELOPMENT (docker-compose)
# ============================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (MySQL в docker-compose)
DB_HOST=db
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=anonimizer_db

# Presidio Services (Docker containers in docker-compose)
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000

# CORS (для локального frontend)
CORS_ORIGIN=http://localhost:5173

# Frontend URL
FRONTEND_URL=http://localhost:5173

# ============================================
# PRODUCTION (Heroku)
# Set via: heroku config:set KEY=VALUE
# ============================================
# NODE_ENV=production
# DB_HOST=your-jawsdb-host.rds.amazonaws.com
# DB_PORT=3306
# DB_USERNAME=your_username
# DB_PASSWORD=your_password
# DB_NAME=your_db_name
# PRESIDIO_ANALYZER_URL=  (leave empty - not used on Heroku)
# PRESIDIO_ANONYMIZER_URL=  (leave empty - not used on Heroku)
# CORS_ORIGIN=https://your-frontend-domain.com
